# ==========================================
# POLYRICH 2D MULTIPLAYER GAME - CONFIGURATION
# ==========================================

# Server port
PORT=4000

# Client origin for CORS (use * for all origins or specific production domain)
CLIENT_ORIGIN="*"

# Node environment (development | production)
NODE_ENV=production

# Database URL
# SQLite default (zero-configuration out of the box):
DATABASE_URL="file:./dev.db"

# PostgreSQL / Supabase connection (Optional for production cloud DB):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# Optional Cloud Storage (Supabase Storage / S3-compatible)
# If left empty, local persistent disk storage (/uploads) is used automatically:
STORAGE_PROVIDER="local"
# S3_ENDPOINT="https://<project-id>.supabase.co/storage/v1/s3"
# S3_BUCKET_NAME="polyrich-assets"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"

# Public HTTPS deployment (Docker Compose production profile)
# Point this domain's DNS A/AAAA records to the server first.
DOMAIN="game.example.com"
